{
  "name": "ceteris-economia-industriale",
  "version": "1.0.0",
  "private": true,
  "description": "App di studio stile Duolingo per il primo parziale di Economia e Politica Industriale (UniFe).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
